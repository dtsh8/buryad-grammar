{
  "name": "buryad-grammar",
  "private": true,
  "version": "1.0.0",
  "description": "Interactive grammar reference for the Buryad (Буряад) language",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \".prettierrc\" \"eslint.config.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "corpus:scrape":    "tsx scripts/scrape.ts",
    "corpus:build-db":  "tsx scripts/build_db.ts",
    "corpus:export":    "tsx scripts/export.ts",
    "corpus:pipeline":  "npm run corpus:scrape && npm run corpus:build-db && npm run corpus:export",
    "corpus:examples":  "tsx scripts/extract_examples.ts",
    "corpus:vocab":     "tsx scripts/build_vocab.ts",
    "corpus:all":       "npm run corpus:scrape && npm run corpus:examples && npm run corpus:vocab"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  }
}
